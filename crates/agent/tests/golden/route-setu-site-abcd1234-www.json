{
  "@id": "setu-site-abcd1234-www",
  "handle": [
    {
      "handler": "static_response",
      "headers": {
        "Location": [
          "https://example.test{http.request.uri}"
        ]
      },
      "status_code": 301
    }
  ],
  "match": [
    {
      "host": [
        "www.example.test"
      ]
    }
  ],
  "terminal": true
}
