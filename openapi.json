    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "super::auth"
        ],
        "summary": "Log in: verify the argon2id hash, rotate the session id (fixation\nguard), store the operator id, and return the operator. Failures count\nper source IP: 10 within 15 minutes → 429 on subsequent attempts.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorOut"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
