  "components": {
    "schemas": {
      "AppListOut": {
        "type": "object",
        "required": [
          "apps"
        ],
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppOut"
            }
          }
        }
      },
      "AppOut": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "homepage": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "AppVersionListOut": {
        "type": "object",
        "required": [
          "versions"
        ],
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppVersionOut"
            }
          }
        }
      },
      "AppVersionOut": {
        "type": "object",
        "required": [
          "id",
          "app_id",
          "version",
          "channel",
          "published_at"
        ],
        "properties": {
          "app_id": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CreateOperatorRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "CreatePlanRequest": {
        "type": "object",
        "required": [
          "name",
          "limits"
        ],
        "properties": {
          "allowed_app_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimitsIn"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateServerRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateServerResponse": {
        "type": "object",
        "required": [
          "server",
          "join_token",
          "install_command"
        ],
        "properties": {
          "install_command": {
            "type": "string",
            "description": "One-line installer using the single binary."
          },
          "join_token": {
            "type": "string",
            "description": "Single-use join token (valid 1 hour); shown once."
          },
          "server": {
            "$ref": "#/components/schemas/ServerOut"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "`{ \"error\": { \"code\": \"...\", \"message\": \"...\" } }` (spec §6).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "HealthOut": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ManifestErrorOut": {
        "type": "object",
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
