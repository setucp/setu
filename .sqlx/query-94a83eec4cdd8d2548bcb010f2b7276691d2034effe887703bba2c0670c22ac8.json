  "db_name": "PostgreSQL",
  "query": "SELECT id, site_id, server_id, site_short_id, site_name, domain, kind, taken_at,\n                    size_bytes, status FROM backups\n             WHERE kind IN ('pre_update', 'pre_restore', 'pre_delete')\n               AND status <> 'deleted'\n               AND taken_at < $1\n             ORDER BY taken_at, id",
