  "query": "SELECT id, kind, site_id, server_id, status, attempts, payload,\n                    log, error, worker, created_at, started_at, finished_at\n             FROM jobs\n             WHERE site_id = $1 AND status IN ('queued', 'running')\n             ORDER BY created_at DESC, id DESC LIMIT 1",
